# Copy to .env.production on the VPS; keep real values out of Git.
# APP_DOMAIN is a hostname only, without scheme, path or trailing slash.
APP_DOMAIN=
ACME_EMAIL=
IMAGE_TAG=local
POSTGRES_DB=omni
POSTGRES_USER=omni
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_MAX_AGE_MS=604800000
MARKETPLACE_TOKEN_ENCRYPTION_KEY=
MARKETPLACE_TOKEN_ENCRYPTION_KEY_VERSION=v1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=OmniStock
SMTP_FROM_EMAIL=
EMAIL_VERIFICATION_EXPIRES_IN_MINUTES=30
PASSWORD_RESET_EXPIRES_IN_MINUTES=30
MERCADO_LIVRE_CONNECTOR_ENABLED=false
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
# Fill only after the final HTTPS domain is selected and registered in DevCenter.
MERCADO_LIVRE_REDIRECT_URI=
ORDER_SYNC_ENABLED=true
STOCK_SYNC_ENABLED=true
MARKETPLACE_WEBHOOKS_ENABLED=true
